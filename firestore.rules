rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'SUPERADMIN' || 
        request.auth.token.role == 'REGISTRAR' || 
        request.auth.token.role == 'ACADEMIC_STAFF' ||
        'admin' in request.auth.token.roles ||
        request.auth.token.role == 'ADMIN'
      );
    }

    // Check if the studentNumber field is being modified or written
    function isModifyingStudentNumber() {
      return 'studentNumber' in request.resource.data && 
        (!resource.data.keys().hasAll(['studentNumber']) || request.resource.data.studentNumber != resource.data.studentNumber);
    }

    // Counter document access - Restricted to Admin/Server only
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Users collection (/users/{uid})
    match /users/{userId} {
      // Allow students to read their own profile and view their studentNumber
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow user creation without studentNumber field (unless admin)
      allow create: if isAdmin() || (isOwner(userId) && !('studentNumber' in request.resource.data));
      
      // Explicitly block students or non-admin roles from writing, editing, or modifying studentNumber
      allow update: if isAdmin() || (
        isOwner(userId) && !isModifyingStudentNumber()
      );
      
      allow delete: if isAdmin();
    }

    // Students collection (/students/{uid})
    match /students/{userId} {
      // Allow students to read their own profile and view their studentNumber
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow user creation without studentNumber field (unless admin)
      allow create: if isAdmin() || (isOwner(userId) && !('studentNumber' in request.resource.data));
      
      // Explicitly block students or non-admin roles from writing, editing, or modifying studentNumber
      allow update: if isAdmin() || (
        isOwner(userId) && !isModifyingStudentNumber()
      );
      
      allow delete: if isAdmin();
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
