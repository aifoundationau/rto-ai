rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.role == 'SUPERADMIN' ||
        request.auth.token.role == 'ADMIN' ||
        ('roles' in request.auth.token && 'SUPERADMIN' in request.auth.token.roles) ||
        ('roles' in request.auth.token && 'admin' in request.auth.token.roles)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email != null && (
          request.auth.token.email.matches('.*@aifoundation\\.net\\.au$') ||
          request.auth.token.email.matches('.*@aifoundation\\.com\\.au$')
        )) ||
        isSuperAdmin() ||
        request.auth.token.role == 'REGISTRAR' || 
        request.auth.token.role == 'ACADEMIC_STAFF' ||
        request.auth.token.role == 'admin'
      );
    }

    function isCourseStaff() {
      return isSignedIn() && (
        isAdmin() ||
        request.auth.token.role == 'INSTRUCTIONAL_DESIGNER'
      );
    }

    // Check if the studentNumber field is being modified or written
    function isModifyingStudentNumber() {
      return 'studentNumber' in request.resource.data && 
        (!resource.data.keys().hasAll(['studentNumber']) || request.resource.data.studentNumber != resource.data.studentNumber);
    }

    // ==========================================
    // Course Builder & Multi-Tenant Rules
    // ==========================================

    // Tenant Configuration (/tenants/{tenantId})
    match /tenants/{tenantId} {
      allow read: if isSignedIn();
      allow write: if isSuperAdmin();
      
      match /{document=**} {
        allow read: if isSignedIn();
        allow write: if isSuperAdmin();
      }
    }

    // Programs & Degrees (/programs/{programId})
    match /programs/{programId} {
      allow read: if (resource.data.status == 'published') || isCourseStaff();
      allow create: if isCourseStaff();
      allow update: if isSuperAdmin() || (
        isCourseStaff() && 
        (resource.data.status != 'published' || request.resource.data.status == 'in_review')
      );
      allow delete: if isSuperAdmin();

      match /outcomes/{outcomeId} {
        allow read: if (get(/databases/$(database)/documents/programs/$(programId)).data.status == 'published') || isCourseStaff();
        allow write: if isCourseStaff();
      }
    }

    // Units / Subjects (/units/{unitId})
    match /units/{unitId} {
      allow read: if (resource.data.status == 'published') || isCourseStaff();
      allow create: if isCourseStaff();
      allow update: if isSuperAdmin() || (
        isCourseStaff() && resource.data.status != 'published'
      );
      allow delete: if isSuperAdmin();

      match /{subcollection=**}/{docId} {
        allow read: if (get(/databases/$(database)/documents/units/$(unitId)).data.status == 'published') || isCourseStaff();
        allow write: if isCourseStaff();
      }
    }

    // Content collection (/content/{docId}) - Public read, Admin write
    match /content/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Google Classroom sync collection (/classroom_sync/{docId})
    match /classroom_sync/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Counter document access - Restricted to Admin/Server only
    match /counters/{counterId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    // Users collection (/users/{uid})
    match /users/{userId} {
      // Allow students to read their own profile and view their studentNumber
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow user creation without studentNumber field (unless admin)
      allow create: if isAdmin() || (isOwner(userId) && !('studentNumber' in request.resource.data));
      
      // Explicitly block students or non-admin roles from writing, editing, or modifying studentNumber
      allow update: if isAdmin() || (
        isOwner(userId) && !isModifyingStudentNumber()
      );
      
      allow delete: if isAdmin();
    }

    // Students collection (/students/{uid})
    match /students/{userId} {
      // Allow students to read their own profile and view their studentNumber
      allow read: if isOwner(userId) || isAdmin();
      
      // Allow user creation without studentNumber field (unless admin)
      allow create: if isAdmin() || (isOwner(userId) && !('studentNumber' in request.resource.data));
      
      // Explicitly block students or non-admin roles from writing, editing, or modifying studentNumber
      allow update: if isAdmin() || (
        isOwner(userId) && !isModifyingStudentNumber()
      );
      
      allow delete: if isAdmin();
    }

    // Default rule for all other documents
    match /{document=**} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
