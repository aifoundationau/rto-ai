                </section>

                <!-- SECTION 8: NOTICE BOARD -->
                <section id="notice-board" class="section-anchor bg-white p-6 rounded-2xl border border-slate-200/80 shadow-xs space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
                        <div>
                            <h3 class="text-lg font-bold text-slate-900 flex items-center gap-2">
                                <i class="fa-regular fa-clipboard text-indigo-600"></i> Notice Board & Announcements
                            </h3>
                            <p class="text-xs text-slate-400">Campus notices broadcasted across the entire EduPulse network</p>
                        </div>
                        <button onclick="showToast('Create Notice modal opened', 'info')" class="text-xs font-bold px-3.5 py-2 bg-purple-600 hover:bg-purple-700 text-white rounded-xl transition-all flex items-center gap-2">
                            <i class="fa-solid fa-plus"></i> Post Announcement
                        </button>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div class="p-4 rounded-xl bg-purple-50/50 border border-purple-100 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-bold text-purple-700 uppercase tracking-wider">Campus Announcement</span>
                                <span class="text-[10px] text-slate-400">Posted Sept 24</span>
                            </div>
                            <h4 class="font-bold text-sm text-slate-800">Annual Science Fair 2026 Registration Open</h4>
                            <p class="text-xs text-slate-600 line-clamp-2">Students from grades 9 through 12 can now register project proposals through the student portal dashboard.</p>
                            <button onclick="openNoticeModal('Annual Science Fair 2026 Registration Open', 'Students from grades 9 through 12 can now register project proposals through the student portal dashboard before October 15th. Project grants up to $500 available for top proposals.')" class="text-xs font-bold text-purple-700 hover:underline inline-block pt-1">Read Full Notice &rarr;</button>
                        </div>

                        <div class="p-4 rounded-xl bg-indigo-50/50 border border-indigo-100 space-y-2">
                            <div class="flex items-center justify-between">
                                <span class="text-[10px] font-bold text-indigo-700 uppercase tracking-wider">IT Infrastructure</span>
                                <span class="text-[10px] text-slate-400">Posted Sept 20</span>
                            </div>
                            <h4 class="font-bold text-sm text-slate-800">Scheduled LMS Portal Maintenance Window</h4>
                            <p class="text-xs text-slate-600 line-clamp-2">EduPulse portal will undergo scheduled server database optimization on Sunday between 02:00 AM and 04:00 AM EST.</p>
                            <button onclick="openNoticeModal('Scheduled LMS Portal Maintenance Window', 'EduPulse portal will undergo scheduled server database optimization on Sunday between 02:00 AM and 04:00 AM EST. Access may be intermittently interrupted during this timeframe.')" class="text-xs font-bold text-indigo-700 hover:underline inline-block pt-1">Read Full Notice &rarr;</button>
                        </div>
                    </div>
                </section>

                <footer class="pt-6 pb-2 text-center text-xs text-slate-400 border-t border-slate-200/60">
                    &copy; 2026 EduPulse LMS Platform. All Rights Reserved. SPIK UI Dashboard Architecture.
                </footer>
            </main>
        </div>
    </div>

    <!-- Notice Modal -->
    <div id="notice-modal" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden flex items-center justify-center p-4">
        <div class="bg-white rounded-2xl max-w-md w-full p-6 shadow-2xl space-y-4">
            <h3 id="modal-title" class="text-lg font-bold text-slate-900"></h3>
            <p id="modal-content" class="text-xs text-slate-600 leading-relaxed"></p>
            <div class="flex justify-end pt-2">
                <button onclick="closeNoticeModal()" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition-colors">Close Notice</button>
            </div>
        </div>
    </div>

    <script>
        // Core Chart Variables
        let examChartInstance = null;
        let demoChartInstance = null;

        // Auto-Scroll to Section & Snap to Top
        function scrollToSection(event, sectionId) {
            if (event) {
                event.preventDefault();
            }

            const targetSection = document.getElementById(sectionId);
            const container = document.getElementById('main-content');

            if (targetSection && container) {
                // Ensure target section scrolls cleanly to the top of the container
                targetSection.scrollIntoView({ behavior: 'smooth', block: 'start' });

                // Update nav highlight active status
                document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active-nav-item'));
                const activeBtn = document.querySelector(`.nav-btn[data-section="${sectionId}"]`);
                if (activeBtn) {
                    activeBtn.classList.add('active-nav-item');
                }
            }
        }

        // Initialize Observer to highlight active sidebar item on manual scroll
        function setupIntersectionObserver() {
            const sections = document.querySelectorAll('.section-anchor');
            const navButtons = document.querySelectorAll('.nav-btn');

            const observerOptions = {
                root: document.getElementById('main-content'),
                rootMargin: '0px 0px -70% 0px',
                threshold: 0
            };

            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        const id = entry.target.getAttribute('id');
                        navButtons.forEach(btn => {
                            if (btn.getAttribute('data-section') === id) {
                                btn.classList.add('active-nav-item');
                            } else {
                                btn.classList.remove('active-nav-item');
                            }
                        });
                    }
                });
            }, observerOptions);

            sections.forEach(section => observer.observe(section));
        }

        // Expandable list items
        function toggleExpandable(headerEl) {
            const parent = headerEl.parentElement;
            const content = parent.querySelector('div:nth-child(2)');
            const arrow = headerEl.querySelector('.icon-arrow');

            if (content) {
                content.classList.toggle('hidden');
                if (arrow) {
                    arrow.classList.toggle('rotate-180');
                }
            }
        }

        function toggleAllExpandables(sectionId, expand) {
            const section = document.getElementById(sectionId);
            if (!section) return;

            const items = section.querySelectorAll('.expandable-item');
            items.forEach(item => {
                const content = item.querySelector('div:nth-child(2)');
                const arrow = item.querySelector('.icon-arrow');
                if (expand) {
                    content.classList.remove('hidden');
                    if (arrow) arrow.classList.add('rotate-180');
                } else {
                    content.classList.add('hidden');
                    if (arrow) arrow.classList.remove('rotate-180');
                }
            });
        }

        // Toast Notifications
        function showToast(message, type = 'info') {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');

            let typeClasses = 'bg-slate-900 text-white';
            let icon = 'fa-circle-info';

            if (type === 'success') {
                typeClasses = 'bg-emerald-600 text-white';
                icon = 'fa-circle-check';
            } else if (type === 'warning') {
                typeClasses = 'bg-amber-600 text-white';
                icon = 'fa-triangle-exclamation';
            }

            toast.className = `pointer-events-auto flex items-center gap-3 px-4 py-3 rounded-xl shadow-xl text-xs font-semibold ${typeClasses} transition-all duration-300 transform translate-y-2 opacity-0`;
            toast.innerHTML = `<i class="fa-solid ${icon} text-sm"></i> <span>${message}</span>`;

            container.appendChild(toast);

            setTimeout(() => {
                toast.classList.remove('translate-y-2', 'opacity-0');
            }, 10);

            setTimeout(() => {
                toast.classList.add('opacity-0', 'translate-y-2');
                setTimeout(() => toast.remove(), 300);
            }, 3000);
        }

        // Table Action: Mark Paid
        function markAsPaid(button) {
            const row = button.closest('tr');
            const statusBadge = row.querySelector('span');
            statusBadge.className = "bg-emerald-100 text-emerald-700 px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase";
            statusBadge.innerText = "Paid";
            button.remove();
            showToast('Invoice marked as paid!', 'success');
        }

        // Star Student Search Filter
        function filterStarStudents() {
            const input = document.getElementById('star-search').value.toLowerCase();
            const rows = document.querySelectorAll('#star-students-body tr');

            rows.forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(input) ? '' : 'none';
            });
        }

        // Sync Google Calendar Simulator
        function syncGoogleCalendar() {
            showToast('Syncing with Google Calendar API...', 'info');
            setTimeout(() => {
                showToast('Google Calendar synced successfully!', 'success');
            }, 1200);
        }

        // Notice Modal
        function openNoticeModal(title, content) {
            document.getElementById('modal-title').innerText = title;
            document.getElementById('modal-content').innerText = content;
            document.getElementById('notice-modal').classList.remove('hidden');
        }

        function closeNoticeModal() {
            document.getElementById('notice-modal').classList.add('hidden');
        }

        // Initialize Chart.js Graphs
        function initCharts() {
            // Exam Results Line Chart
            const ctxExam = document.getElementById('examResultsChart').getContext('2d');
            examChartInstance = new Chart(ctxExam, {
                type: 'line',
                data: {
                    labels: ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6'],
                    datasets: [
                        {
                            label: 'Student Pass Rate (%)',
                            data: [82, 85, 88, 84, 91, 95],
                            borderColor: '#8b5cf6',
                            backgroundColor: 'rgba(139, 92, 246, 0.1)',
                            fill: true,
                            tension: 0.4,
                            borderWidth: 3
                        },
                        {
                            label: 'Teacher Grading Completeness (%)',
                            data: [75, 78, 82, 89, 93, 97],
                            borderColor: '#38bdf8',
                            backgroundColor: 'transparent',
                            borderDash: [5, 5],
                            tension: 0.4,
                            borderWidth: 2
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, font: { size: 11, family: 'Plus Jakarta Sans' } } }
                    },
                    scales: {
                        y: { min: 60, max: 100, grid: { color: '#f1f5f9' } },
                        x: { grid: { display: false } }
                    }
                }
            });

            // Demographics Donut Chart
            const ctxDemo = document.getElementById('demographicsChart').getContext('2d');
            demoChartInstance = new Chart(ctxDemo, {
                type: 'doughnut',
                data: {
                    labels: ['Female Students', 'Male Students'],
                    datasets: [{
                        data: [8250, 6750],
                        backgroundColor: ['#8b5cf6', '#6366f1'],
                        borderWidth: 0
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '75%',
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }

        function updateChartData(filter) {
            if (!examChartInstance) return;
            if (filter === 'weekly') {
                examChartInstance.data.labels = ['Week 1', 'Week 2', 'Week 3', 'Week 4', 'Week 5', 'Week 6'];
                examChartInstance.data.datasets[0].data = [82, 85, 88, 84, 91, 95];
            } else {
                examChartInstance.data.labels = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun'];
                examChartInstance.data.datasets[0].data = [78, 81, 85, 89, 92, 96];
            }
            examChartInstance.update();
        }

        // Window Load Setup
        window.onload = function () {
            initCharts();
            setupIntersectionObserver();
        };
    </script>
</body>
</html>
