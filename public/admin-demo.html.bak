<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-50">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduPulse - LMS Admin Dashboard</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['"Plus Jakarta Sans"', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f5f3ff',
                            100: '#ede9fe',
                            500: '#8b5cf6',
                            600: '#7c3aed',
                            700: '#6d28d9',
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        .custom-scrollbar::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #f1f5f9;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #94a3b8;
        }
        .active-nav-item {
            background-color: #f3e8ff !important;
            color: #7c3aed !important;
            border-right: 4px solid #7c3aed;
            font-weight: 600;
        }
        .section-anchor {
            scroll-margin-top: 0px;
        }
    </style>
</head>
<body class="h-full flex flex-col overflow-hidden text-slate-800 antialiased selection:bg-purple-500 selection:text-white">

    <div id="toast-container" class="fixed top-5 right-5 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Main Container -->
    <div class="flex h-screen w-full overflow-hidden">

        <!-- LEFT SIDEBAR -->
        <aside class="w-64 bg-white border-r border-slate-200 flex flex-col flex-shrink-0 z-20 shadow-sm">
            <!-- Branding Header -->
            <div class="h-16 px-6 flex items-center gap-3 border-b border-slate-100 flex-shrink-0">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-purple-600 via-indigo-600 to-pink-500 flex items-center justify-center text-white shadow-md shadow-purple-200">
                    <i class="fa-solid font-bold text-xl fa-bolt"></i>
                </div>
                <div>
                    <h1 class="font-extrabold text-xl tracking-tight bg-gradient-to-r from-purple-700 via-indigo-600 to-pink-600 bg-clip-text text-transparent">EduPulse</h1>
                    <p class="text-[10px] font-semibold tracking-wider text-slate-400 uppercase">LMS Admin Platform</p>
                </div>
            </div>

            <!-- Navigation Links -->
            <nav class="flex-1 overflow-y-auto custom-scrollbar py-4 px-3 space-y-1">
                <p class="px-3 text-[11px] font-bold text-slate-400 uppercase tracking-wider mb-2">Main Menu</p>

                <a href="#admin-overview" onclick="scrollToSection(event, 'admin-overview')" class="nav-btn group flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-slate-600 hover:bg-purple-50 hover:text-purple-700 transition-all duration-150 active-nav-item" data-section="admin-overview">
                    <i class="fa-solid fa-chart-pie w-6 text-center text-slate-400 group-hover:text-purple-600 transition-colors"></i>
                    <span class="ml-2">Admin Overview</span>
                </a>

                <a href="#student-enquiries" onclick="scrollToSection(event, 'student-enquiries')" class="nav-btn group flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-slate-600 hover:bg-purple-50 hover:text-purple-700 transition-all duration-150" data-section="student-enquiries">
                    <i class="fa-solid fa-user-graduate w-6 text-center text-slate-400 group-hover:text-purple-600 transition-colors"></i>
                    <span class="ml-2">Student Enquiries</span>
                    <span class="ml-auto bg-purple-100 text-purple-700 text-xs font-bold px-2 py-0.5 rounded-full">4</span>
                </a>

                <a href="#teacher-admin-requests" onclick="scrollToSection(event, 'teacher-admin-requests')" class="nav-btn group flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-slate-600 hover:bg-purple-50 hover:text-purple-700 transition-all duration-150" data-section="teacher-admin-requests">
                    <i class="fa-solid fa-chalkboard-user w-6 text-center text-slate-400 group-hover:text-purple-600 transition-colors"></i>
                    <span class="ml-2">Teacher Requests</span>
                    <span class="ml-auto bg-amber-100 text-amber-700 text-xs font-bold px-2 py-0.5 rounded-full">3</span>
                </a>

                <a href="#parent-enquiries" onclick="scrollToSection(event, 'parent-enquiries')" class="nav-btn group flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-slate-600 hover:bg-purple-50 hover:text-purple-700 transition-all duration-150" data-section="parent-enquiries">
                    <i class="fa-solid fa-people-roof w-6 text-center text-slate-400 group-hover:text-purple-600 transition-colors"></i>
                    <span class="ml-2">Parent Enquiries</span>
                </a>

                <a href="#accounts-due" onclick="scrollToSection(event, 'accounts-due')" class="nav-btn group flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-slate-600 hover:bg-purple-50 hover:text-purple-700 transition-all duration-150" data-section="accounts-due">
                    <i class="fa-solid fa-file-invoice-dollar w-6 text-center text-slate-400 group-hover:text-purple-600 transition-colors"></i>
                    <span class="ml-2">Accounts Due</span>
                    <span class="ml-auto bg-rose-100 text-rose-700 text-xs font-bold px-2 py-0.5 rounded-full">Due</span>
                </a>

                <p class="px-3 text-[11px] font-bold text-slate-400 uppercase tracking-wider mt-6 mb-2">Management</p>

                <a href="#calendar-events" onclick="scrollToSection(event, 'calendar-events')" class="nav-btn group flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-slate-600 hover:bg-purple-50 hover:text-purple-700 transition-all duration-150" data-section="calendar-events">
                    <i class="fa-regular fa-calendar-check w-6 text-center text-slate-400 group-hover:text-purple-600 transition-colors"></i>
                    <span class="ml-2">Calendar Events</span>
                </a>

                <a href="#action-feed" onclick="scrollToSection(event, 'action-feed')" class="nav-btn group flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-slate-600 hover:bg-purple-50 hover:text-purple-700 transition-all duration-150" data-section="action-feed">
                    <i class="fa-solid fa-rss w-6 text-center text-slate-400 group-hover:text-purple-600 transition-colors"></i>
                    <span class="ml-2">Action Feed</span>
                </a>

                <a href="#notice-board" onclick="scrollToSection(event, 'notice-board')" class="nav-btn group flex items-center px-3 py-2.5 text-sm font-medium rounded-xl text-slate-600 hover:bg-purple-50 hover:text-purple-700 transition-all duration-150" data-section="notice-board">
                    <i class="fa-regular fa-clipboard w-6 text-center text-slate-400 group-hover:text-purple-600 transition-colors"></i>
                    <span class="ml-2">Notice Board</span>
                </a>
            </nav>

            <!-- Bottom User Profile snippet in sidebar -->
            <div class="p-3 border-t border-slate-100 bg-slate-50/50">
                <div class="flex items-center gap-3 p-2 rounded-xl bg-white border border-slate-200/80 shadow-xs">
                    <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80" alt="Avatar" class="w-9 h-9 rounded-lg object-cover ring-2 ring-purple-100">
                    <div class="overflow-hidden">
                        <h4 class="text-xs font-bold text-slate-800 truncate">Priscilla Lily</h4>
                        <p class="text-[10px] text-purple-600 font-semibold truncate">System Admin</p>
                    </div>
                </div>
            </div>
        </aside>

        <!-- RIGHT MAIN CONTENT PANEL -->
        <div class="flex-1 flex flex-col h-full overflow-hidden">

            <!-- HEADER BAR -->
            <header class="h-16 bg-white border-b border-slate-200 px-6 flex items-center justify-between flex-shrink-0 z-10">
                <div class="flex items-center gap-4 flex-1 max-w-md">
                    <div class="relative w-full">
                        <i class="fa-solid fa-magnifying-glass absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                        <input type="text" placeholder="What do you want to find? (Search students, requests, files...)" class="w-full pl-10 pr-4 py-2 bg-slate-100/80 border border-transparent rounded-xl text-xs text-slate-700 placeholder-slate-400 focus:bg-white focus:border-purple-400 focus:ring-2 focus:ring-purple-100 outline-none transition-all">
                    </div>
                </div>

                <div class="flex items-center gap-3">
                    <button onclick="showToast('No new unread system warnings', 'info')" class="w-9 h-9 rounded-xl border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-100 transition-colors relative">
                        <i class="fa-regular fa-bell text-sm"></i>
                        <span class="absolute top-2 right-2 w-2 h-2 bg-purple-600 rounded-full ring-2 ring-white"></span>
                    </button>

                    <button onclick="showToast('Direct messaging panel opened', 'info')" class="w-9 h-9 rounded-xl border border-slate-200 flex items-center justify-center text-slate-600 hover:bg-slate-100 transition-colors">
                        <i class="fa-regular fa-comment-dots text-sm"></i>
                    </button>

                    <div class="h-6 w-px bg-slate-200 mx-1"></div>

                    <div class="flex items-center gap-3 cursor-pointer group" onclick="showToast('Admin profile settings', 'info')">
                        <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=100&auto=format&fit=crop&q=80" alt="Profile" class="w-9 h-9 rounded-xl object-cover ring-2 ring-purple-500/20 group-hover:ring-purple-500 transition-all">
                        <div class="hidden sm:block text-left">
                            <span class="block text-xs font-bold text-slate-800 leading-tight">Priscilla Lily</span>
                            <span class="block text-[10px] text-slate-400 font-medium">Super Administrator</span>
                        </div>
                        <i class="fa-solid fa-chevron-down text-slate-400 text-[10px]"></i>
                    </div>
                </div>
            </header>

            <!-- MAIN SCROLLABLE CONTENT AREA -->
            <main id="main-content" class="flex-1 overflow-y-auto custom-scrollbar p-6 space-y-12 bg-slate-50 scroll-smooth">

                <!-- SECTION 1: ADMIN OVERVIEW -->
                <section id="admin-overview" class="section-anchor space-y-6 pt-2">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                        <div>
                            <h2 class="text-2xl font-extrabold text-slate-900 tracking-tight">Admin Overview</h2>
                            <p class="text-xs text-slate-500 font-medium">Welcome back, Priscilla! Here is what's happening at EduPulse today.</p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-semibold text-slate-500">Academic Term:</span>
                            <select class="text-xs font-bold bg-white border border-slate-200 rounded-lg px-3 py-1.5 text-slate-700 shadow-xs focus:ring-2 focus:ring-purple-200 outline-none cursor-pointer">
                                <option>Fall Semester 2026</option>
                                <option>Spring Semester 2026</option>
                            </select>
                        </div>
                    </div>

                    <!-- Pastel KPI Cards Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <!-- Card 1 -->
                        <div class="p-5 rounded-2xl bg-purple-50/80 border border-purple-100 flex items-center justify-between shadow-xs hover:shadow-md transition-shadow">
                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-purple-600 mb-1">Students</p>
                                <h3 class="text-2xl font-black text-purple-950">15.00K</h3>
                                <p class="text-[11px] text-emerald-600 font-bold mt-1 flex items-center gap-1">
                                    <i class="fa-solid fa-arrow-trend-up"></i> +12% this month
                                </p>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-purple-500 text-white flex items-center justify-center text-xl shadow-md shadow-purple-200">
                                <i class="fa-solid fa-user-graduate"></i>
                            </div>
                        </div>

                        <!-- Card 2 -->
                        <div class="p-5 rounded-2xl bg-sky-50/80 border border-sky-100 flex items-center justify-between shadow-xs hover:shadow-md transition-shadow">
                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-sky-600 mb-1">Teachers</p>
                                <h3 class="text-2xl font-black text-sky-950">2.00K</h3>
                                <p class="text-[11px] text-emerald-600 font-bold mt-1 flex items-center gap-1">
                                    <i class="fa-solid fa-arrow-trend-up"></i> +4 new this week
                                </p>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-sky-500 text-white flex items-center justify-center text-xl shadow-md shadow-sky-200">
                                <i class="fa-solid fa-chalkboard-user"></i>
                            </div>
                        </div>

                        <!-- Card 3 -->
                        <div class="p-5 rounded-2xl bg-amber-50/80 border border-amber-100 flex items-center justify-between shadow-xs hover:shadow-md transition-shadow">
                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-amber-600 mb-1">Parents</p>
                                <h3 class="text-2xl font-black text-amber-950">5.60K</h3>
                                <p class="text-[11px] text-amber-700 font-bold mt-1 flex items-center gap-1">
                                    <i class="fa-solid fa-check-double"></i> 94% Portal Active
                                </p>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-amber-500 text-white flex items-center justify-center text-xl shadow-md shadow-amber-200">
                                <i class="fa-solid fa-people-roof"></i>
                            </div>
                        </div>

                        <!-- Card 4 -->
                        <div class="p-5 rounded-2xl bg-emerald-50/80 border border-emerald-100 flex items-center justify-between shadow-xs hover:shadow-md transition-shadow">
                            <div>
                                <p class="text-xs font-bold uppercase tracking-wider text-emerald-600 mb-1">Earnings</p>
                                <h3 class="text-2xl font-black text-emerald-950">$19.3K</h3>
                                <p class="text-[11px] text-emerald-600 font-bold mt-1 flex items-center gap-1">
                                    <i class="fa-solid fa-circle-up"></i> +8.4% target met
                                </p>
                            </div>
                            <div class="w-12 h-12 rounded-xl bg-emerald-500 text-white flex items-center justify-center text-xl shadow-md shadow-emerald-200">
                                <i class="fa-solid fa-wallet"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Charts Grid -->
                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                        <!-- All Exam Results Line Chart -->
                        <div class="lg:col-span-2 bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex flex-col justify-between">
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <h3 class="font-bold text-slate-800 text-base">All Exam Results Trend</h3>
                                    <p class="text-xs text-slate-400">Teacher evaluations vs Student performance grades</p>
                                </div>
                                <div class="flex items-center gap-2 bg-slate-100 p-1 rounded-xl">
                                    <button onclick="updateChartData('weekly')" class="text-xs font-semibold px-3 py-1 rounded-lg bg-white shadow-xs text-purple-700 transition-all">Weekly</button>
                                    <button onclick="updateChartData('monthly')" class="text-xs font-semibold px-3 py-1 rounded-lg text-slate-500 hover:text-slate-800 transition-all">Monthly</button>
                                </div>
                            </div>
                            <div class="h-64 relative w-full">
                                <canvas id="examResultsChart"></canvas>
                            </div>
                        </div>

                        <!-- Student Demographics Chart -->
                        <div class="bg-white p-5 rounded-2xl border border-slate-200/80 shadow-xs flex flex-col justify-between">
                            <div>
                                <h3 class="font-bold text-slate-800 text-base">Student Demographics</h3>
                                <p class="text-xs text-slate-400">Gender distribution across all enrolled years</p>
                            </div>
                            <div class="h-52 relative my-2 flex items-center justify-center">
                                <canvas id="demographicsChart"></canvas>
                            </div>
                            <div class="grid grid-cols-2 gap-2 pt-3 border-t border-slate-100 text-center">
                                <div class="p-2 rounded-xl bg-purple-50">
                                    <span class="text-[10px] uppercase font-bold text-purple-600 block">Female</span>
                                    <span class="text-base font-black text-purple-900">8,250 (55%)</span>
                                </div>
                                <div class="p-2 rounded-xl bg-indigo-50">
                                    <span class="text-[10px] uppercase font-bold text-indigo-600 block">Male</span>
                                    <span class="text-base font-black text-indigo-900">6,750 (45%)</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Star Students Interactive Table -->
                    <div class="bg-white rounded-2xl border border-slate-200/80 shadow-xs overflow-hidden">
                        <div class="p-5 border-b border-slate-100 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                            <div>
                                <h3 class="font-bold text-slate-800 text-base">Star Performing Students</h3>
                                <p class="text-xs text-slate-400">Top ranked academic performers for current semester</p>
                            </div>
                            <div class="flex items-center gap-3">
                                <div class="relative">
                                    <i class="fa-solid fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                    <input type="text" id="star-search" oninput="filterStarStudents()" placeholder="Search student..." class="pl-8 pr-3 py-1.5 text-xs bg-slate-50 border border-slate-200 rounded-lg outline-none focus:border-purple-500">
                                </div>
                                <button onclick="showToast('Exporting student list CSV...', 'success')" class="text-xs font-semibold px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-lg transition-colors flex items-center gap-1.5">
                                    <i class="fa-solid fa-download"></i> Export
                                </button>
                            </div>
                        </div>
                        <div class="overflow-x-auto">
                            <table class="w-full text-left border-collapse">
                                <thead>
                                    <tr class="bg-slate-50/70 border-b border-slate-100 text-[11px] font-bold text-slate-400 uppercase tracking-wider">
                                        <th class="p-4 w-10 text-center"><input type="checkbox" class="rounded text-purple-600"></th>
                                        <th class="p-4">Student</th>
                                        <th class="p-4">Grade / Class</th>
                                        <th class="p-4">GPA Score</th>
                                        <th class="p-4">Attendance</th>
                                        <th class="p-4 text-right">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="star-students-body" class="divide-y divide-slate-100 text-xs font-medium text-slate-700">
                                    <tr class="hover:bg-purple-50/30 transition-colors">
                                        <td class="p-4 text-center"><input type="checkbox" class="rounded text-purple-600"></td>
                                        <td class="p-4 flex items-center gap-3">
                                            <img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&auto=format&fit=crop&q=80" class="w-8 h-8 rounded-full object-cover">
                                            <div>
                                                <div class="font-bold text-slate-900">Sophia Martinez</div>
                                                <div class="text-[10px] text-slate-400">ID: STU-2026-089</div>
                                            </div>
                                        </td>
                                        <td class="p-4"><span class="bg-purple-100 text-purple-700 px-2.5 py-1 rounded-md text-[11px] font-bold">Grade 11-A</span></td>
                                        <td class="p-4 font-extrabold text-emerald-600">3.98 / 4.0</td>
                                        <td class="p-4">
                                            <div class="flex items-center gap-2">
                                                <div class="w-16 bg-slate-100 h-2 rounded-full overflow-hidden">
                                                    <div class="bg-emerald-500 h-full w-[98%]"></div>
                                                </div>
                                                <span class="text-[11px]">98%</span>
                                            </div>
                                        </td>
                                        <td class="p-4 text-right">
                                            <button onclick="showToast('Viewing Sophia Martinez report card', 'info')" class="text-purple-600 hover:text-purple-800 font-bold text-xs bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-lg transition-colors">View Profile</button>
                                        </td>
                                    </tr>
                                    <tr class="hover:bg-purple-50/30 transition-colors">
                                        <td class="p-4 text-center"><input type="checkbox" class="rounded text-purple-600"></td>
                                        <td class="p-4 flex items-center gap-3">
                                            <img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&auto=format&fit=crop&q=80" class="w-8 h-8 rounded-full object-cover">
                                            <div>
                                                <div class="font-bold text-slate-900">Liam Chen</div>
                                                <div class="text-[10px] text-slate-400">ID: STU-2026-112</div>
                                            </div>
                                        </td>
                                        <td class="p-4"><span class="bg-purple-100 text-purple-700 px-2.5 py-1 rounded-md text-[11px] font-bold">Grade 12-B</span></td>
                                        <td class="p-4 font-extrabold text-emerald-600">3.95 / 4.0</td>
                                        <td class="p-4">
                                            <div class="flex items-center gap-2">
                                                <div class="w-16 bg-slate-100 h-2 rounded-full overflow-hidden">
                                                    <div class="bg-emerald-500 h-full w-[95%]"></div>
                                                </div>
                                                <span class="text-[11px]">95%</span>
                                            </div>
                                        </td>
                                        <td class="p-4 text-right">
                                            <button onclick="showToast('Viewing Liam Chen report card', 'info')" class="text-purple-600 hover:text-purple-800 font-bold text-xs bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-lg transition-colors">View Profile</button>
                                        </td>
                                    </tr>
                                    <tr class="hover:bg-purple-50/30 transition-colors">
                                        <td class="p-4 text-center"><input type="checkbox" class="rounded text-purple-600"></td>
                                        <td class="p-4 flex items-center gap-3">
                                            <img src="https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&auto=format&fit=crop&q=80" class="w-8 h-8 rounded-full object-cover">
                                            <div>
                                                <div class="font-bold text-slate-900">Emma Watson</div>
                                                <div class="text-[10px] text-slate-400">ID: STU-2026-045</div>
                                            </div>
                                        </td>
                                        <td class="p-4"><span class="bg-purple-100 text-purple-700 px-2.5 py-1 rounded-md text-[11px] font-bold">Grade 10-C</span></td>
                                        <td class="p-4 font-extrabold text-emerald-600">3.91 / 4.0</td>
                                        <td class="p-4">
                                            <div class="flex items-center gap-2">
                                                <div class="w-16 bg-slate-100 h-2 rounded-full overflow-hidden">
                                                    <div class="bg-emerald-500 h-full w-[96%]"></div>
                                                </div>
