# Public Firebase Client Config
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourClientApiKeyPlaceholder"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="000000000000"
NEXT_PUBLIC_FIREBASE_APP_ID="1:000000000000:web:0000000000000000000000"

# Firebase Admin Service Account Credentials (Server Only)
FIREBASE_PROJECT_ID="your-project"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ...\n-----END PRIVATE KEY-----\n"

# Database Code & Multi-Tenant ID
NEXT_PUBLIC_DATABASE_CODE="rto-ai"
# Firestore Database Instance ID: leave empty or "(default)" for default instance, or set to "rto-ai" if a named database is created in GCP
FIRESTORE_DATABASE_ID="(default)"
NEXT_PUBLIC_FIRESTORE_DATABASE_ID="(default)"

# AI & External APIs
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GOOGLE_CLASSROOM_API_KEY="YOUR_GOOGLE_CLASSROOM_API_KEY"
PEXELS_API_KEY="YOUR_PEXELS_API_KEY"
